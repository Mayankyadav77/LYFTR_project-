# Lyftr AI Configuration

# Comma-separated pool of at least 2 Gemini API keys (Key IDs are key_1, key_2, ...)
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Target LiteLLM model
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite storage URL (inside Docker volume: sqlite:////data/app.db)
DATABASE_URL=sqlite:///./app.db

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables X-Simulate-Failure test hook for automated verification
ENABLE_FAILURE_SIMULATION=true

# Frontend API Target (for React Vite)
VITE_API_URL=http://localhost:8000
